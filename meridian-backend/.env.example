# Copy to .env and adjust values for your environment.

# REQUIRED in production - set a long random secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Set to True only during local development.
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Comma-separated list of trusted CSRF origins.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to True when serving over HTTPS (production / behind a TLS proxy).
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000